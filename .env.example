APP_NAME="MW Realty"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mw_realty
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google reCAPTCHA v3 — leave blank to disable verification (forms keep working, just unprotected).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# "Continue with Google" — customer accounts only. Leave blank to hide the button.
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# and set its authorized redirect URI to GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/customer/auth/google/callback"

# Auto-translates agent/company bio text into other active site languages.
# Free for the first 500,000 characters/month — get a key at console.cloud.google.com
# (enable the "Cloud Translation API" on a project, then create an API key).
GOOGLE_TRANSLATE_API_KEY=

# Powers the AI chat widget's natural-language property search (function-calling — grounded
# strictly against the real properties DB, never free-text). Leave the active provider's key
# blank to disable the widget's replies (it shows a fallback message instead of breaking the
# page). Both providers' code ships regardless of which is active — CHATBOT_PROVIDER just picks
# which one actually runs; switching (or back) is a one-line change here, no code change.
CHATBOT_PROVIDER=groq
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
CHATBOT_NAME=Remi

VITE_APP_NAME="${APP_NAME}"

# Stripe plan subscriptions (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=aed
